<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 30. API 31 and above read data_extraction_rules.xml
    instead, so the two have to be kept in step.

    Everything is backed up except the desk preferences, which hold the ntfy access
    token. Restoring a watchlist, mute list and feed configuration onto a new device is
    the whole value of having backup on; shipping a bearer token to Google Drive is not,
    and the app can ask for it again in one screen.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="desk.xml"/>
</full-backup-content>
