<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: the app's own ink, very slightly graded.

  A flat near-black reads as a hole on a dark wallpaper, and the launcher gives the icon
  no border of its own, so a two-stop gradient is what keeps the shape looking like an
  object rather than a cutout.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF17202B" />
                <item android:offset="1" android:color="#FF0A0E13" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
