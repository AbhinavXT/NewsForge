<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawn in-project rather than pulled from material-icons: the app needs ten
    glyphs, not a thousand, and these are tinted at the call site by Icon().
    Stroked line art at 1.8dp, to sit with the rest of the chrome rather than
    compete with the category accents, which are the only colour that means
    anything here.
-->
